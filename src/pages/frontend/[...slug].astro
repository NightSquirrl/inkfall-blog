---
import PostLayout from "@/layouts/PostLayout.astro";
import { getFrontendHref, getFrontendOgImageHref, getVisibleFrontend } from "@/utils/posts";
import { getTranslator, I18nKey } from "@/i18n";
import { withBase } from "@/utils/paths";
import { render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getVisibleFrontend();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"frontend">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const t = getTranslator();
---

<PostLayout
  post={post}
  headings={headings}
  href={getFrontendHref(post)}
  ogImageHref={getFrontendOgImageHref(post)}
  backHref={withBase("/frontend")}
  backLabel={t(I18nKey.backToFrontend)}
>
  <Content />
</PostLayout>
