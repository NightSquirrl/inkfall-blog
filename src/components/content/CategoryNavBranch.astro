---
import { getHref } from "@/utils/posts";
import type { AnyPostEntry } from "@/utils/posts";

interface CategoryNode {
  segment: string;
  path: string;
  children: Map<string, CategoryNode>;
  posts: AnyPostEntry[];
}

interface Props {
  node: CategoryNode;
  prefix: string;
  depth?: number;
}

const { node, prefix, depth = 0 } = Astro.props;

const countInNode = (n: CategoryNode): number =>
  n.posts.length + [...n.children.values()].reduce((sum, c) => sum + countInNode(c), 0);

const sortNodes = (list: CategoryNode[]): CategoryNode[] => {
  const getNum = (str: string) => {
    const match = str.match(/^(\d+)/);
    return match ? Number(match[1]) : Infinity;
  };
  const sortedList = [...list].sort((left, right) => {
    const n1 = getNum(left.segment);
    const n2 = getNum(right.segment);
    if (!isNaN(n1) && !isNaN(n2)) return n1 - n2;
    return left.segment.localeCompare(right.segment);
  });
  for (const n of sortedList) {
    const sortedChildren = sortNodes([...n.children.values()]);
    n.children = new Map(sortedChildren.map((c) => [c.segment, c]));
  }
  return sortedList;
};

const anchor = `${prefix}-${encodeURIComponent(node.path)}`;
const sortedChildren = sortNodes([...node.children.values()]);
const sortedPosts = [...node.posts].sort((a, b) => a.id.localeCompare(b.id, undefined, { numeric: true }));
---

<div class="data-[active=true]:bg-accent-soft/60" data-category-link={anchor} data-active="false">
  <a
    href={`#${anchor}`}
    class="flex items-center justify-between gap-2 px-3 py-2 text-sm font-medium transition-colors hover:bg-accent-soft hover:text-accent-strong data-[active=true]:text-accent-strong"
    style={`padding-left: ${12 + depth * 16}px`}
  >
    <span class="text-foreground min-w-0 truncate">{node.segment}</span>
    <span class="text-foreground-muted shrink-0 text-xs tabular-nums">{countInNode(node)}</span>
  </a>

  <div class="ml-[18px] flex flex-col border-l border-border/70" style={`margin-left: ${18 + depth * 16}px`}>
    {sortedChildren.map((child) => <Astro.self node={child} prefix={prefix} depth={depth + 1} />)}

    {
      sortedPosts.map((post) => (
        <a
          href={getHref(post)}
          class="text-foreground-muted flex items-center gap-2 py-1.5 pr-3 text-sm transition-colors hover:bg-accent-soft hover:text-accent-strong"
          style={`padding-left: ${12 + (depth + 2) * 16}px`}
        >
          <span class="text-foreground-muted shrink-0">·</span>
          <span class="min-w-0 truncate">{post.data.title}</span>
        </a>
      ))
    }
  </div>
</div>
