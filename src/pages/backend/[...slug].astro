---
import PostLayout from "@/layouts/PostLayout.astro";
import { getBackendHref, getBackendOgImageHref, getVisibleBackend } from "@/utils/posts";
import { getTranslator, I18nKey } from "@/i18n";
import { render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getVisibleBackend();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"backend">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const t = getTranslator();
---

<PostLayout
  post={post}
  headings={headings}
  href={getBackendHref(post)}
  ogImageHref={getBackendOgImageHref(post)}
  backHref="/backend"
  backLabel={t(I18nKey.backToBackend)}
>
  <Content />
</PostLayout>
