---
import PostLayout from "@/layouts/PostLayout.astro";
import { getInterviewHref, getInterviewOgImageHref, getVisibleInterview } from "@/utils/posts";
import { getTranslator, I18nKey } from "@/i18n";
import { withBase } from "@/utils/paths";
import { render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getVisibleInterview();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"interview">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const t = getTranslator();
---

<PostLayout
  post={post}
  headings={headings}
  href={getInterviewHref(post)}
  ogImageHref={getInterviewOgImageHref(post)}
  backHref={withBase("/interview")}
  backLabel={t(I18nKey.backToInterview)}
>
  <Content />
</PostLayout>
