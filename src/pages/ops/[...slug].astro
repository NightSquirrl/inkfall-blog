---
import PostLayout from "@/layouts/PostLayout.astro";
import { getOpsHref, getOpsOgImageHref, getVisibleOps } from "@/utils/posts";
import { getTranslator, I18nKey } from "@/i18n";
import { render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getVisibleOps();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"ops">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const t = getTranslator();
---

<PostLayout
  post={post}
  headings={headings}
  href={getOpsHref(post)}
  ogImageHref={getOpsOgImageHref(post)}
  backHref="/ops"
  backLabel={t(I18nKey.backToOps)}
>
  <Content />
</PostLayout>
